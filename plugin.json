{
  "name": "token-ops",
  "displayName": "Token Ops: AI Token Saver",
  "version": "0.3.0",
  "description": "Stop Cursor from wasting tokens on broad repo reads. Runs locally with no API key, account, or cloud backend.",
  "publisher": "token-ops",
  "license": "MIT",
  "categories": ["Productivity", "Agent Orchestration"],
  "keywords": ["tokens", "context", "cursor", "mcp", "vibe-coding"],
  "homepage": "https://github.com/maikoo811/token-ops",
  "bugs": {
    "url": "https://github.com/maikoo811/token-ops/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maikoo811/token-ops"
  },
  "privacy": {
    "localOnly": true,
    "requiresApiKey": false,
    "requiresAccount": false,
    "telemetry": "off-by-default",
    "summary": "Token Ops runs as a local MCP server. No source code leaves your machine by default."
  },
  "components": {
    "rules": ["./rules/token-ops.mdc"],
    "skills": ["./skills/token-ops"],
    "commands": ["./commands/compact-context.md", "./commands/token-report.md"],
    "mcpServers": {
      "token-ops": {
        "command": "node",
        "args": ["${PLUGIN_ROOT}/mcp/server.js"]
      }
    }
  }
}
